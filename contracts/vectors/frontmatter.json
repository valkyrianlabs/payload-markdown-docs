{
  "contractVersion": 1,
  "description": "Frontmatter parsing (src/sync/frontmatter.ts parseDocsFrontmatter; cli/src/docs.cpp parse_frontmatter). Issues and warnings are compared by code and exact message. Inputs carry no path, so issues have no path.",
  "cases": [
    {
      "name": "supported scalars",
      "markdown": "---\ntitle: Installation\nnavTitle: Install\ndescription: Install payload-markdown.\norder: 10\ndraft: false\nstatus: published\nslug: installation\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {
          "title": "Installation",
          "navTitle": "Install",
          "description": "Install payload-markdown.",
          "order": 10,
          "draft": false,
          "status": "published",
          "slug": "installation"
        },
        "issues": [],
        "warnings": []
      }
    },
    {
      "name": "list fields",
      "markdown": "---\nredirectFrom:\n  - /docs/install\ntags:\n- getting-started\n-   spaced\ndependencies:\n  - \"@valkyrianlabs/payload-markdown\"\n  - 'single'\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {
          "redirectFrom": [
            "/docs/install"
          ],
          "tags": [
            "getting-started",
            "spaced"
          ],
          "dependencies": [
            "@valkyrianlabs/payload-markdown",
            "single"
          ]
        },
        "issues": [],
        "warnings": []
      }
    },
    {
      "name": "empty list field",
      "markdown": "---\ntags:\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {
          "tags": []
        },
        "issues": [],
        "warnings": []
      }
    },
    {
      "name": "flow lists",
      "markdown": "---\ntags: [a, \"b, c\", 'd']\nredirectFrom: []\ndependencies: [x, y,]\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {
          "tags": [
            "a",
            "b, c",
            "d"
          ],
          "redirectFrom": [],
          "dependencies": [
            "x",
            "y"
          ]
        },
        "issues": [],
        "warnings": []
      }
    },
    {
      "name": "invalid flow list (nested)",
      "markdown": "---\ntags: [a, [b]]\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {},
        "issues": [
          {
            "code": "invalid_frontmatter",
            "message": "Frontmatter field \"tags\" has an invalid flow list; use [a, b] or \"- item\" lines."
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "invalid flow list (unclosed)",
      "markdown": "---\ntags: [a, b\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {},
        "issues": [
          {
            "code": "invalid_frontmatter",
            "message": "Frontmatter field \"tags\" has an invalid flow list; use [a, b] or \"- item\" lines."
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "invalid flow list (empty item)",
      "markdown": "---\ntags: [a, , b]\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {},
        "issues": [
          {
            "code": "invalid_frontmatter",
            "message": "Frontmatter field \"tags\" has an invalid flow list; use [a, b] or \"- item\" lines."
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "scalar value on a list field",
      "markdown": "---\ntags: one\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {},
        "issues": [
          {
            "code": "invalid_frontmatter",
            "message": "Frontmatter field \"tags\" must use list item syntax."
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "nested mapping under unknown key is ignored",
      "markdown": "---\ntitle: Real Title\nseo:\n  title: SEO Override\n  slug: other\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {
          "title": "Real Title"
        },
        "issues": [],
        "warnings": [
          {
            "code": "invalid_frontmatter",
            "message": "Unknown frontmatter field \"seo\" was ignored."
          }
        ]
      }
    },
    {
      "name": "nested value under known scalar",
      "markdown": "---\ntitle:\n  en: Hello\n  de: Hallo\nslug: ok\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {
          "title": "",
          "slug": "ok"
        },
        "issues": [
          {
            "code": "invalid_frontmatter",
            "message": "Frontmatter field \"title\" does not support nested or multi-line values."
          }
        ],
        "warnings": [
          {
            "code": "invalid_frontmatter",
            "message": "Frontmatter field \"title\" is empty; the title is inferred instead."
          }
        ]
      }
    },
    {
      "name": "multi-line plain scalar continuation",
      "markdown": "---\ndescription: first line\n  second line\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {
          "description": "first line"
        },
        "issues": [
          {
            "code": "invalid_frontmatter",
            "message": "Frontmatter field \"description\" does not support nested or multi-line values."
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "indented line without context",
      "markdown": "---\n  title: Indented\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {},
        "issues": [
          {
            "code": "invalid_frontmatter",
            "message": "Unsupported indented frontmatter line:   title: Indented"
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "non-list line under list field",
      "markdown": "---\ntags:\n  key: value\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {
          "tags": []
        },
        "issues": [
          {
            "code": "invalid_frontmatter",
            "message": "Frontmatter field \"tags\" only supports \"- item\" list entries."
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "list item without list field",
      "markdown": "---\n- stray\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {},
        "issues": [
          {
            "code": "invalid_frontmatter",
            "message": "Frontmatter array item does not belong to a supported array field."
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "list items under unknown key are ignored",
      "markdown": "---\naliases:\n  - a\n  - b\ntitle: T\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {
          "title": "T"
        },
        "issues": [],
        "warnings": [
          {
            "code": "invalid_frontmatter",
            "message": "Unknown frontmatter field \"aliases\" was ignored."
          }
        ]
      }
    },
    {
      "name": "block scalar on known field",
      "markdown": "---\ndescription: >\n  long text\n  more\ntitle: After\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {
          "title": "After"
        },
        "issues": [
          {
            "code": "invalid_frontmatter",
            "message": "Frontmatter field \"description\" uses a YAML block scalar (>), which is not supported; use a single-line value."
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "block scalar with chomping",
      "markdown": "---\ntitle: |-\n  Multi\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {},
        "issues": [
          {
            "code": "invalid_frontmatter",
            "message": "Frontmatter field \"title\" uses a YAML block scalar (|-), which is not supported; use a single-line value."
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "block scalar on unknown key",
      "markdown": "---\nnotes: |\n  anything: here\n  - and lists\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {},
        "issues": [],
        "warnings": [
          {
            "code": "invalid_frontmatter",
            "message": "Unknown frontmatter field \"notes\" was ignored."
          }
        ]
      }
    },
    {
      "name": "full-line comments",
      "markdown": "---\n# comment\ntitle: T\n  # indented comment\norder: 2\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {
          "title": "T",
          "order": 2
        },
        "issues": [],
        "warnings": []
      }
    },
    {
      "name": "trailing comment is literal",
      "markdown": "---\ntitle: Hello # not a comment\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {
          "title": "Hello # not a comment"
        },
        "issues": [],
        "warnings": []
      }
    },
    {
      "name": "double quotes",
      "markdown": "---\ntitle: \"Quoted: value\"\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {
          "title": "Quoted: value"
