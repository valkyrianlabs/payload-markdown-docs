    {
      "name": "description empty",
      "markdown": "---\ndescription:\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {
          "description": ""
        },
        "issues": [],
        "warnings": []
      }
    },
    {
      "name": "unknown keys (snake and kebab case)",
      "markdown": "---\nog_image: x.png\nlast-updated: 2026-01-01\nTitle: Capital\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {},
        "issues": [],
        "warnings": [
          {
            "code": "invalid_frontmatter",
            "message": "Unknown frontmatter field \"og_image\" was ignored."
          },
          {
            "code": "invalid_frontmatter",
            "message": "Unknown frontmatter field \"last-updated\" was ignored."
          },
          {
            "code": "invalid_frontmatter",
            "message": "Unknown frontmatter field \"Title\" was ignored."
          }
        ]
      }
    },
    {
      "name": "quoted key is unsupported",
      "markdown": "---\n\"title\": x\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {},
        "issues": [
          {
            "code": "invalid_frontmatter",
            "message": "Unsupported frontmatter line: \"title\": x"
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "key starting with digit is unsupported",
      "markdown": "---\n1st: x\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {},
        "issues": [
          {
            "code": "invalid_frontmatter",
            "message": "Unsupported frontmatter line: 1st: x"
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "line without colon",
      "markdown": "---\njust text\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {},
        "issues": [
          {
            "code": "invalid_frontmatter",
            "message": "Unsupported frontmatter line: just text"
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "duplicate keys: last wins",
      "markdown": "---\ntitle: First\ntitle: Second\n---\n# Body\n",
      "expect": {
        "content": "# Body\n",
        "frontmatter": {
          "title": "Second"
        },
        "issues": [],
        "warnings": []
      }
    },
    {
      "name": "no frontmatter",
      "markdown": "# Installation\n\nBody",
      "expect": {
        "content": "# Installation\n\nBody",
        "frontmatter": {},
        "issues": [],
        "warnings": []
      }
    },
    {
      "name": "missing closing delimiter",
      "markdown": "---\ntitle: Open\n# Body\n",
      "expect": {
        "content": "---\ntitle: Open\n# Body\n",
        "frontmatter": {},
        "issues": [
          {
            "code": "invalid_frontmatter",
            "message": "Frontmatter block is missing a closing delimiter."
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "only opening delimiter",
      "markdown": "---\n",
      "expect": {
        "content": "---\n",
        "frontmatter": {},
        "issues": [
          {
            "code": "invalid_frontmatter",
            "message": "Frontmatter block is missing a closing delimiter."
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "delimiter without newline",
      "markdown": "---",
      "expect": {
        "content": "---",
        "frontmatter": {},
        "issues": [],
        "warnings": []
      }
    },
    {
      "name": "opening delimiter with trailing space is not frontmatter",
      "markdown": "--- \ntitle: X\n---\n",
      "expect": {
        "content": "--- \ntitle: X\n---\n",
        "frontmatter": {},
        "issues": [],
        "warnings": []
      }
    },
    {
      "name": "closing delimiter may have surrounding spaces",
      "markdown": "---\ntitle: X\n  ---  \nBody",
      "expect": {
        "content": "Body",
        "frontmatter": {
          "title": "X"
        },
        "issues": [],
        "warnings": []
      }
    },
    {
      "name": "empty frontmatter",
      "markdown": "---\n---\n# Body",
      "expect": {
        "content": "# Body",
        "frontmatter": {},
        "issues": [],
        "warnings": []
      }
    },
    {
      "name": "BOM before frontmatter",
      "markdown": "﻿---\ntitle: BOM title\nslug: bom\n---\n# BOM body",
      "expect": {
        "content": "# BOM body",
        "frontmatter": {
          "title": "BOM title",
          "slug": "bom"
        },
        "issues": [],
        "warnings": []
      }
    },
    {
      "name": "BOM without frontmatter",
      "markdown": "﻿# Heading",
      "expect": {
        "content": "# Heading",
        "frontmatter": {},
        "issues": [],
        "warnings": []
      }
    },
    {
      "name": "CRLF frontmatter and body",
      "markdown": "---\r\ntitle: CRLF\r\norder: 2\r\n---\r\n\r\n# Body\r\nline\r\n",
      "expect": {
        "content": "# Body\nline\n",
        "frontmatter": {
          "title": "CRLF",
          "order": 2
        },
        "issues": [],
        "warnings": []
      }
    },
    {
      "name": "lone CR frontmatter",
      "markdown": "---\rtitle: Old Mac\r---\rBody",
      "expect": {
        "content": "Body",
        "frontmatter": {
          "title": "Old Mac"
        },
        "issues": [],
        "warnings": []
      }
    },
    {
      "name": "body keeps content after one leading newline",
      "markdown": "---\ntitle: T\n---\n\n\nBody",
      "expect": {
        "content": "\nBody",
        "frontmatter": {
          "title": "T"
        },
        "issues": [],
        "warnings": []
      }
    },
    {
      "name": "thematic break later is not frontmatter",
      "markdown": "# Title\n\n---\n\ntext\n",
      "expect": {
        "content": "# Title\n\n---\n\ntext\n",
        "frontmatter": {},
        "issues": [],
        "warnings": []
      }
    }
  ]
}
