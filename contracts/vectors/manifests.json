{
  "contractVersion": 1,
  "description": "Manifest validation (src/sync/validate.ts validateDocsManifest + src/sync/routeCollisions.ts findManifestRouteCollisions; cli/src/docs.cpp validate_manifest + find_route_collisions). Issues/warnings are compared by code and path, in order. \"manifestJson\" cases must be parsed from that exact text (number formatting matters).",
  "cases": [
    {
      "name": "valid minimal",
      "manifest": {
        "version": 1,
        "source": {
          "id": "main-docs"
        },
        "files": [
          {
            "content": "# Home\n",
            "path": "index.md",
            "sha256": "7d48eefbcff2495cc4b0cd99ea783bbc46184d78af064c56e1a7dc7ae9dba3aa"
          }
        ]
      },
      "options": {
        "routeBase": "/main-docs",
        "assetRouteBase": "/plugins/main-docs"
      },
      "expect": {
        "ok": true,
        "issues": [],
        "warnings": [],
        "files": [
          {
            "path": "index.md",
            "route": "/main-docs",
            "title": "Home"
          }
        ],
        "assets": [],
        "routeCollisions": []
      }
    },
    {
      "name": "valid with metadata",
      "manifest": {
        "version": 1,
        "source": {
          "id": "main-docs",
          "branch": "main",
          "commit": "abc",
          "repository": "o/r"
        },
        "files": [
          {
            "content": "---\ntitle: Intro\n---\nText\n",
            "path": "guide/intro.md",
            "sha256": "19a83361611e2d709c2969de6b2e727c9e51868fbef79cd1b609df5e562fae56"
          }
        ],
        "mode": "sync",
        "deleteBehavior": "draft",
        "publish": true
      },
      "options": {
        "routeBase": "/main-docs",
        "assetRouteBase": "/plugins/main-docs"
      },
      "expect": {
        "ok": true,
        "issues": [],
        "warnings": [],
        "files": [
          {
            "path": "guide/intro.md",
            "route": "/main-docs/guide/intro",
            "title": "Intro"
          }
        ],
        "assets": [],
        "routeCollisions": []
      }
    },
    {
      "name": "version 1.0 is accepted",
