option(
  'install_skill_data',
  type: 'boolean',
  value: false,
  description: 'Install bundled pmdocs skill data (the payload-markdown-docs skill and the vendored payload-markdown skill) under the system share directory.',
)
option(
  'companion_skill_data',
  type: 'feature',
  value: 'enabled',
  description: 'With install_skill_data, also install the payload-markdown skill vendored in skills/payload-markdown. "disabled" skips it; "enabled" and "auto" install it.',
)
